# ============================================
# Streamium Server — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# Google OAuth Client ID
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=paste-your-google-client-id-here

# MongoDB connection string
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/streamium
# Local example: mongodb://localhost:27017/streamium
MONGODB_URI=mongodb://localhost:27017/streamium

# Session secret (any long random string)
SESSION_SECRET=change-me-to-a-random-secret-string

# Port (optional, defaults to 3000)
PORT=3000
